diff -ruN a/tests/unit/test_isp_palette.py b/tests/unit/test_isp_palette.py
--- a/tests/unit/test_isp_palette.py	2026-10-11 12:10:31.490620670 +0900
+++ b/tests/unit/test_isp_palette.py	2026-10-11 12:10:48.903373890 +0900
@@ -47,6 +47,18 @@
         palette_table("viridis")
 
 
+def test_jet_is_the_classic_map_and_not_rainbow() -> None:
+    """Jet's six knots, and the two properties that tell it from `rainbow`: it darkens at both
+    ends, and its luma is not monotone (which is why it is never the default)."""
+    jet = palette_table("jet")
+    for index, rgb in ((0, (0, 0, 128)), (32, (0, 0, 255)), (96, (0, 255, 255)), (160, (255, 255, 0)),
+                       (224, (255, 0, 0)), (255, (128, 0, 0))):
+        assert tuple(jet[index]) == rgb, index
+    assert tuple(jet[128]) == (128, 255, 128)  # half-way between cyan and yellow
+    assert not np.array_equal(jet, palette_table("rainbow"))
+    assert np.any(np.diff(_luma(jet)) < 0)
+
